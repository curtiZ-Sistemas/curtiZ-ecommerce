{
  "name": "curtiz-commerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:store": "pnpm --filter @curtiz/store dev",
    "dev:panel": "pnpm --filter @curtiz/panel dev",
    "build": "tsx scripts/validate-production.ts && corepack pnpm -r --if-present build",
    "build:development": "tsx scripts/validate-development.ts && corepack pnpm -r --if-present build",
    "build:staging": "tsx scripts/validate-staging.ts && corepack pnpm -r --if-present build",
    "build:production": "tsx scripts/validate-production.ts && corepack pnpm -r --if-present build",
    "build:worker": "tsx scripts/validate-production.ts && corepack pnpm --filter @curtiz/store build:worker",
    "build:worker:panel": "tsx scripts/validate-production.ts && corepack pnpm --filter @curtiz/panel build:worker",
    "build:worker:staging": "tsx scripts/validate-staging.ts && corepack pnpm --filter @curtiz/store build:worker",
    "build:worker:panel:staging": "tsx scripts/validate-staging.ts && corepack pnpm --filter @curtiz/panel build:worker",
    "deploy:dry-run": "corepack pnpm --filter @curtiz/store deploy:dry-run",
    "deploy:dry-run:panel": "corepack pnpm --filter @curtiz/panel deploy:dry-run",
    "deploy:staging": "corepack pnpm --filter @curtiz/store deploy:staging && corepack pnpm --filter @curtiz/panel deploy:staging",
    "deploy:production": "corepack pnpm --filter @curtiz/store deploy:production && corepack pnpm --filter @curtiz/panel deploy:production",
    "build:store:staging": "tsx scripts/validate-staging.ts && corepack pnpm --filter @curtiz/store build",
    "build:panel:staging": "tsx scripts/validate-staging.ts && corepack pnpm --filter @curtiz/panel build",
    "build:local": "tsx scripts/validate-development.ts && corepack pnpm -r --if-present build",
    "lint": "eslint scripts tests/db-static && corepack pnpm -r --if-present lint",
    "lint:scripts": "eslint scripts",
    "typecheck": "tsc -p scripts/tsconfig.json && corepack pnpm -r --if-present typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "test": "vitest run scripts/environment-validation.test.ts tests/db-static && corepack pnpm -r --if-present test",
    "test:components": "corepack pnpm --filter @curtiz/store test:components",
    "test:db:mock": "corepack pnpm --filter @curtiz/supabase test",
    "test:db:static": "vitest run tests/db-static",
    "test:environment": "vitest run scripts/environment-validation.test.ts",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "measure:performance": "tsx scripts/measure-storefront-performance.ts",
    "measure:performance:budget": "tsx scripts/measure-storefront-performance.ts http://localhost:3000 --warm --assert",
    "measure:performance:budget:strict": "tsx scripts/measure-storefront-performance.ts http://localhost:3000 --warm --assert --strict",
    "test:storefront:routes": "tsx scripts/check-storefront-routes.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "validate:development": "tsx scripts/validate-development.ts",
    "validate:staging": "tsx scripts/validate-staging.ts",
    "validate:production": "tsx scripts/validate-production.ts",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build:local"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.2.11",
    "prettier": "^3.6.2",
    "rclone.js": "0.6.6",
    "supabase": "^2.33.9",
    "tsx": "^4.20.3",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "wrangler": "4.86.0"
  }
}

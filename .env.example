NODE_ENV=production
APP_ENV=production

# URLs públicas atuais do Worker
NEXT_PUBLIC_STORE_URL=https://curtiz-ecommerce.sistemas-curtiz.workers.dev
NEXT_PUBLIC_PANEL_URL=https://curtiz-painel.sistemas-curtiz.workers.dev

# Domínio pai compartilhado pelos dois hosts. Não use URL, protocolo ou caminho.
AUTH_COOKIE_DOMAIN=sistemas-curtiz.workers.dev
# Necessário apenas para contas demo em staging remoto.
STAGING_DEMO_HOSTS=

# Supabase remoto. Nunca use o projeto de produção em testes automatizados.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Checkout e integrações começam desativados. Credenciais vazias só são exigidas
# quando o provider ou sua flag correspondente for habilitado.
CHECKOUT_ENABLED=false
ALLOW_GUEST_CHECKOUT=false
PAYMENT_PROVIDER=disabled
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_SUCCESS_URL=
MERCADO_PAGO_PENDING_URL=
MERCADO_PAGO_FAILURE_URL=

SHIPPING_PROVIDER=disabled
MELHOR_ENVIO_ENABLED=false
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_ACCESS_TOKEN=
MELHOR_ENVIO_REFRESH_TOKEN=
MELHOR_ENVIO_WEBHOOK_SECRET=
CORREIOS_API_TOKEN=

EMAIL_PROVIDER=disabled
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
MARKETING_PROVIDER=mock

WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

ERP_PROVIDER=disabled
BLING_ACCESS_TOKEN=
OMIE_APP_KEY=
OMIE_APP_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false
AUTH_RATE_LIMIT_ENABLED=true
DEMO_MODE=false
DEMO_USERS_PASSWORD=
DEMO_SESSION_SECRET=
INVENTORY_RESERVATION_MINUTES=30
REQUIRE_INTERNAL_MFA=false
REQUIRE_DUAL_APPROVAL_FOR_PRIVILEGED_USERS=true
MAINTENANCE_MODE=false
APP_VERSION=0.1.0
PII_ENCRYPTION_KEY=
AUDIT_HASH_KEY=
ALLOWED_ORIGINS=https://curtiz-ecommerce.sistemas-curtiz.workers.dev,https://curtiz-painel.sistemas-curtiz.workers.dev
